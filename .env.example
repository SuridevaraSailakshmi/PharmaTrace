# ============================================================
# PharmaTrace — Production & Development Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ────────────────────────────────────────────────────────────
# Public Configuration (Accessible on Client and Server)
# ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_APP_NAME=PharmaTrace
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────
# Server-Only Secrets (MUST NOT be exposed to Client Bundle)
# ────────────────────────────────────────────────────────────
# Required for atomic sequence operations, administrative functions, and server-side RPC execution
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Node Environment ('development', 'test', 'production')
NODE_ENV=development
