# ============================================================
# PharmaTrace — .gitignore
# ============================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage
/test-results
/playwright-report
/blob-report

# Next.js
/.next/
/out/

# Production build
/build
/dist

# Environment variables
.env
.env.*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor / IDE
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Certificates
*.pem

# Supabase local
supabase/.temp/
supabase/.branches/

# Generated
/generated/
